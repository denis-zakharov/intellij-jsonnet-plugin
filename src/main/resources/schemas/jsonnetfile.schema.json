{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "jsonnet-bundler jsonnetfile.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "git": {
                "type": "object",
                "required": ["remote", "subdir"],
                "properties": {
                  "remote": {
                    "type": "string",
                    "description": "Git remote URL, e.g. https://github.com/grafana/jsonnet-libs.git"
                  },
                  "subdir": {
                    "type": "string",
                    "description": "Subdirectory within the repo to vendor."
                  }
                }
              },
              "local": {
                "type": "object",
                "required": ["directory"],
                "properties": {
                  "directory": { "type": "string" }
                }
              }
            }
          },
          "version": {
            "type": "string",
            "description": "Git ref (branch, tag, or commit) to pin the dependency to."
          },
          "sum": { "type": "string" }
        }
      }
    },
    "legacyImports": {
      "type": "boolean",
      "description": "Whether to also vendor top-level legacy (non-subdir) import paths."
    }
  }
}
