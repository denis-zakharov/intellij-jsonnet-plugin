<idea-plugin>
    <id>com.dz.intellij-jsonnet-tanka</id>
    <name>Jsonnet + Tanka</name>
    <vendor email="dizaharov@gmail.com">dz</vendor>

    <description><![CDATA[
        <p>
            Native (non-LSP) IntelliJ support for <b>Jsonnet</b> and <b>Tanka</b>, built on a real PSI
            grammar and the embedded, shaded <a href="https://github.com/databricks/sjsonnet">sjsonnet</a>
            evaluator &mdash; no external language server process.
        </p>
        <h3>Jsonnet editing</h3>
        <ul>
            <li>Syntax and semantic highlighting (locals, parameters, fields, <code>std</code> calls), with a Color Scheme page</li>
            <li>Go to definition, find usages and rename for locals, parameters and fields &mdash; including <code>lib.foo.bar</code> through imports; Go to Symbol across the project</li>
            <li>Import paths resolve like Tanka does: relative to the file, then <code>main.jsonnet</code>'s directory, <code>vendor/</code> and <code>lib/</code></li>
            <li>Completion for locals, parameters, keywords, object fields (through <code>self</code>, <code>super</code>, <code>$</code>, imports and function calls) and import paths; documentation for the standard library, Tanka's native functions, the <code>tk</code> module and functions annotated with <a href="https://github.com/jsonnet-libs/docsonnet">docsonnet</a> (your own <code>lib/</code>, k8s-libsonnet, xtd)</li>
            <li>Unresolved-reference errors (cross-checked against sjsonnet's own scope analysis), an unused local / hidden field inspection with quick fixes, parameter-name inlay hints</li>
            <li>Formatter, folding, structure view, brace matching, commenting</li>
        </ul>
        <h3>Evaluation</h3>
        <ul>
            <li><b>Jsonnet Preview</b> tool window: live JSON or YAML output of the focused file, with ext vars and top-level arguments; Ctrl/Cmd+click an output line to jump to the source that produced it &mdash; sees unsaved editor buffers</li>
            <li><b>Jsonnet Imports</b> tool window: what a file imports (transitively) or what imports it</li>
            <li>Evaluate a selected expression in the context of the file's top-level locals</li>
        </ul>
        <h3>Tanka</h3>
        <ul>
            <li>New Tanka environment action, JSON Schema support for <code>spec.json</code> and <code>jsonnetfile.json</code>, environment icons</li>
            <li>Run configurations and a gutter action for <code>jsonnet</code>/<code>tk show|diff|apply|export</code>, a side-by-side comparison of two environments' <code>tk show</code> output, and a <code>jb install</code> quick fix &mdash; these use your own <code>tk</code>, <code>jb</code> and <code>jsonnet</code> binaries and are optional</li>
        </ul>
        <p>
            Everything else runs inside the IDE. Anything that needs Tanka's Go-injected native functions
            (<code>parseYaml</code>, Helm, Kustomize, ...) can only be evaluated through <code>tk</code>.
        </p>
    ]]></description>

    <change-notes><![CDATA[
        <p><b>0.1.0</b> &mdash; first release: Jsonnet language support, embedded evaluator with Preview and
        import graph tool windows, and Tanka integration. See the CHANGELOG for details.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.lang.JsonnetFileType"
            fieldName="INSTANCE"
            language="Jsonnet"
            extensions="jsonnet"/>
        <fileType
            name="Libsonnet"
            implementationClass="com.dz.intellijjsonnet.lang.LibsonnetFileType"
            fieldName="INSTANCE"
            language="Jsonnet"
            extensions="libsonnet"/>

        <lang.parserDefinition
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.lang.JsonnetParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetSyntaxHighlighterFactory"/>

        <lang.braceMatcher
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetBraceMatcher"/>

        <lang.commenter
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetCommenter"/>

        <lang.foldingBuilder
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetFoldingBuilder"/>

        <lang.elementManipulator
            forClass="com.dz.intellijjsonnet.lang.psi.JsonnetImportExpr"
            implementationClass="com.dz.intellijjsonnet.lang.psi.JsonnetImportExprManipulator"/>

        <lang.psiStructureViewFactory
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.structure.JsonnetStructureViewFactory"/>

        <stubElementTypeHolder class="com.dz.intellijjsonnet.lang.psi.JsonnetTypes"/>

        <stubIndex implementation="com.dz.intellijjsonnet.lang.stubs.JsonnetBindIndex"/>

        <stubIndex implementation="com.dz.intellijjsonnet.lang.stubs.JsonnetFieldIndex"/>

        <gotoSymbolContributor implementation="com.dz.intellijjsonnet.lang.stubs.JsonnetGotoSymbolContributor"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetKeywordCompletionContributor"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.stdlib.StdLibCompletionContributor"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.tanka.TankaNativeFunctionCompletionContributor"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.tanka.TankaTkModuleCompletionContributor"/>

        <typedHandler implementation="com.dz.intellijjsonnet.editor.JsonnetDotAutoPopupHandler"/>

        <lang.findUsagesProvider
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetFindUsagesProvider"/>

        <lang.documentationProvider
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.stdlib.StdLibDocumentationProvider"/>

        <lang.documentationProvider
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.docsonnet.DocsonnetDocumentationProvider"/>

        <lang.formatter
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.formatter.JsonnetFormattingModelBuilder"/>

        <json.jsonSchemaProviderFactory implementation="com.dz.intellijjsonnet.tanka.schema.TankaJsonSchemaProviderFactory"/>

        <codeInsight.unresolvedReferenceQuickFixProvider implementation="com.dz.intellijjsonnet.tanka.JbInstallQuickFixProvider"/>

        <notificationGroup id="Jsonnet" displayType="BALLOON"/>

        <iconProvider implementation="com.dz.intellijjsonnet.tanka.TankaFileIconProvider"/>

        <annotator
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetUnresolvedReferenceAnnotator"/>

        <annotator
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetSemanticHighlightingAnnotator"/>

        <colorSettingsPage implementation="com.dz.intellijjsonnet.editor.JsonnetColorSettingsPage"/>

        <codeInsight.parameterNameHints
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetInlayParameterHintsProvider"/>

        <localInspection language="Jsonnet"
                         shortName="JsonnetUnusedDeclaration"
                         displayName="Unused local or hidden field"
                         groupName="Jsonnet"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.dz.intellijjsonnet.inspection.JsonnetUnusedDeclarationInspection"/>

        <toolWindow id="Jsonnet Preview"
                    anchor="right"
                    icon="/icons/jsonnet.svg"
                    factoryClass="com.dz.intellijjsonnet.editor.preview.JsonnetPreviewToolWindowFactory"/>

        <toolWindow id="Jsonnet Imports"
                    anchor="right"
                    icon="/icons/jsonnet.svg"
                    factoryClass="com.dz.intellijjsonnet.imports.JsonnetImportGraphToolWindowFactory"/>

        <configurationType implementation="com.dz.intellijjsonnet.editor.runconfig.JsonnetRunConfigurationType"/>

        <runLineMarkerContributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.runconfig.TankaEnvironmentRunLineMarkerProvider"/>
    </extensions>

    <actions>
        <action id="Jsonnet.EvaluateFile"
                class="com.dz.intellijjsonnet.editor.EvaluateJsonnetFileAction"
                text="Open Jsonnet Preview"
                description="Open the Jsonnet Preview tool window, evaluated with the embedded sjsonnet interpreter">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="Jsonnet.ShowImportGraph"
                class="com.dz.intellijjsonnet.imports.ShowJsonnetImportGraphAction"
                text="Show Jsonnet Import Graph"
                description="Open the Jsonnet Imports tool window: what this file imports, or what imports it">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="Jsonnet.NewTankaEnvironment"
                class="com.dz.intellijjsonnet.tanka.NewTankaEnvironmentAction">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>

        <action id="Jsonnet.CompareTankaEnvironments"
                class="com.dz.intellijjsonnet.tanka.CompareTankaEnvironmentsAction"
                text="Compare Tanka Environment With..."
                description="Run 'tk show' for this environment and another one, and open the result in a diff view">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <action id="Jsonnet.EvaluateExpression"
                class="com.dz.intellijjsonnet.editor.EvaluateJsonnetExpressionAction"
                text="Evaluate Jsonnet Expression"
                description="Evaluate the selected expression (plus this file's top-level locals) with the embedded sjsonnet interpreter">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
