<idea-plugin>
    <id>com.dz.intellij-jsonnet-tanka</id>
    <name>Jsonnet + Tanka</name>
    <vendor email="dizaharov@gmail.com">dz</vendor>

    <description><![CDATA[
        Native (non-LSP) IntelliJ support for Jsonnet and Tanka, built on a
        PSI grammar and the embedded, shaded <a href="https://github.com/databricks/sjsonnet">sjsonnet</a>
        evaluator — no external language server process.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.lang.JsonnetFileType"
            fieldName="INSTANCE"
            language="Jsonnet"
            extensions="jsonnet"/>
        <fileType
            name="Libsonnet"
            implementationClass="com.dz.intellijjsonnet.lang.LibsonnetFileType"
            fieldName="INSTANCE"
            language="Jsonnet"
            extensions="libsonnet"/>

        <lang.parserDefinition
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.lang.JsonnetParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetSyntaxHighlighterFactory"/>

        <lang.braceMatcher
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetBraceMatcher"/>

        <lang.commenter
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetCommenter"/>

        <lang.foldingBuilder
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetFoldingBuilder"/>

        <psi.referenceContributor
            language="Jsonnet"
            implementation="com.dz.intellijjsonnet.lang.psi.reference.JsonnetImportReferenceContributor"/>

        <lang.psiStructureViewFactory
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.structure.JsonnetStructureViewFactory"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.stdlib.StdLibCompletionContributor"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.tanka.TankaNativeFunctionCompletionContributor"/>

        <completion.contributor
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.tanka.TankaTkModuleCompletionContributor"/>

        <lang.documentationProvider
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.stdlib.StdLibDocumentationProvider"/>

        <formattingService implementation="com.dz.intellijjsonnet.formatter.JsonnetExternalFormattingService"/>

        <json.jsonSchemaProviderFactory implementation="com.dz.intellijjsonnet.tanka.schema.TankaJsonSchemaProviderFactory"/>

        <codeInsight.unresolvedReferenceQuickFixProvider implementation="com.dz.intellijjsonnet.tanka.JbInstallQuickFixProvider"/>

        <notificationGroup id="Jsonnet" displayType="BALLOON"/>

        <iconProvider implementation="com.dz.intellijjsonnet.tanka.TankaFileIconProvider"/>

        <annotator
            language="Jsonnet"
            implementationClass="com.dz.intellijjsonnet.editor.JsonnetUnresolvedReferenceAnnotator"/>

        <toolWindow id="Jsonnet Preview"
                    anchor="right"
                    icon="/icons/jsonnet.svg"
                    factoryClass="com.dz.intellijjsonnet.editor.preview.JsonnetPreviewToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="Jsonnet.EvaluateFile"
                class="com.dz.intellijjsonnet.editor.EvaluateJsonnetFileAction"
                text="Open Jsonnet Preview"
                description="Open the Jsonnet Preview tool window, evaluated with the embedded sjsonnet interpreter">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="Jsonnet.NewTankaEnvironment"
                class="com.dz.intellijjsonnet.tanka.NewTankaEnvironmentAction">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
